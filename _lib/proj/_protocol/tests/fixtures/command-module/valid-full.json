{
  "schema": "swawkit.command-module/v12",
  "execution": {
    "type": "native"
  },
  "requires": [
    {
      "provider": ".dev/setup",
      "export": "environment"
    }
  ],
  "provides": [
    {
      "id": "command"
    }
  ],
  "facets": [
    {
      "id": "run",
      "kind": "operation",
      "renderer": "run",
      "icon": "▶",
      "label": {
        "zh-CN": "运行",
        "en": "Run"
      },
      "summary": {
        "zh-CN": "运行命令",
        "en": "Run command"
      },
      "resolver": {
        "type": "command",
        "address": "swaw/context",
        "arguments": [
          {
            "bind": "commandAddress"
          }
        ],
        "acceptsTail": true
      }
    }
  ],
  "subjectKinds": [
    {
      "kind": "context",
      "facets": [
        {
          "id": "show",
          "kind": "projection",
          "renderer": "overview",
          "icon": "◉",
          "label": {
            "zh-CN": "查看",
            "en": "Show"
          },
          "summary": {
            "zh-CN": "查看上下文",
            "en": "Show Context"
          },
          "resolver": {
            "type": "command",
            "address": "swaw/context/show",
            "arguments": [
              {
                "bind": "subject.id"
              }
            ],
            "returns": "swawkit.context/v2"
          }
        }
      ]
    }
  ]
}
